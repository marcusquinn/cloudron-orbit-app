#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# SPDX-FileCopyrightText: 2026 Marcus Quinn
#
# Prints the values to enter in Orbit's Admin -> Email page to send
# through Cloudron's mail relay. Orbit keeps its SMTP settings in its
# database and cannot read them from the environment, so they are copied by
# hand once. The output includes the relay password: run it in the Web
# Terminal only.
set -euo pipefail

if [[ -z "${CLOUDRON_MAIL_SMTP_SERVER:-}" ]]; then
	printf 'Cloudron mail is turned off for this app (Email section of the app settings).\n' >&2
	printf 'Enter your own SMTP server in Orbit, or turn it on and restart the app.\n' >&2
	exit 1
fi

printf 'Host:         %s\n' "$CLOUDRON_MAIL_SMTP_SERVER"
printf 'Encryption:   None (local relay only)\n'
printf 'Port:         %s\n' "$CLOUDRON_MAIL_SMTP_PORT"
printf 'Username:     %s\n' "$CLOUDRON_MAIL_SMTP_USERNAME"
printf 'Password:     %s\n' "$CLOUDRON_MAIL_SMTP_PASSWORD"
printf 'From address: %s\n' "$CLOUDRON_MAIL_FROM"
printf 'From name:    %s\n' "${CLOUDRON_MAIL_FROM_DISPLAY_NAME:-Orbit}"
printf '\nThe relay is on the internal Cloudron network, so no TLS is needed.\n'
