#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# SPDX-FileCopyrightText: 2026 Marcus Quinn
#
# The Orbit CLI with this app's configuration, for the Cloudron Web Terminal.
# It runs as the cloudron user, like the server. Commands that need the SQLite
# database to themselves (root, recovery-link, setup-token, backup restore)
# fail while the server runs; use orbit-offline for those.
set -euo pipefail

# shellcheck source=lib/orbit-env.sh
source /app/code/lib/orbit-env.sh
orbit_export_env keep-restore-settings
export HOME=/app/data
cd /app/data

if [[ "$(id -u)" -eq 0 ]]; then
	exec gosu cloudron:cloudron "$ORBIT_BIN" "$@"
fi
exec "$ORBIT_BIN" "$@"
