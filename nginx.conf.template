#
# Between Cloudron's proxy and Orbit. start.sh fills @CLOUDRON_PROXY@ (the
# container's default gateway, where Cloudron's proxy and health checker
# connect from) and @ORBIT_PORT@.
#
# Orbit in production answers only requests that a trusted proxy marks as
# https, and trusts only 127.0.0.1 (this nginx). Cloudron serves the app only
# over HTTPS but its health checker sends no X-Forwarded-Proto, so nginx sets
# it for every request. The client address is taken from X-Forwarded-For only
# when Cloudron's proxy sent the request; a client cannot forge it, and other
# containers on the Cloudron network are seen as their own address.

user cloudron;
worker_processes 2;
pid /run/nginx/nginx.pid;
error_log stderr warn;

events {
	worker_connections 1024;
}

http {
	access_log off;
	server_tokens off;
	keepalive_timeout 65;

	client_body_temp_path /run/nginx/client-body;
	proxy_temp_path /run/nginx/proxy;
	fastcgi_temp_path /run/nginx/fastcgi;
	scgi_temp_path /run/nginx/scgi;
	uwsgi_temp_path /run/nginx/uwsgi;

	map $http_upgrade $connection_upgrade {
		default upgrade;
		'' '';
	}

	set_real_ip_from @CLOUDRON_PROXY@;
	real_ip_header X-Forwarded-For;
	# Cloudron's proxy appends the client address; earlier entries come from
	# the client and are ignored.
	real_ip_recursive off;

	upstream orbit {
		server 127.0.0.1:@ORBIT_PORT@;
		keepalive 16;
	}

	server {
		listen 8000 default_server;

		# Orbit enforces its own upload limits (ORBIT_UPLOAD_MAX_*). Uploads,
		# imports and export downloads stream through without spooling to /run.
		client_max_body_size 0;
		proxy_request_buffering off;
		proxy_buffering off;
		# Live updates, chat and co-editing use long-lived WebSockets.
		proxy_read_timeout 1h;
		proxy_send_timeout 1h;

		proxy_http_version 1.1;
		proxy_set_header Host $http_host;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection $connection_upgrade;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto https;
		proxy_set_header Forwarded "";
		proxy_set_header X-Real-IP "";

		location / {
			proxy_pass http://orbit;
		}
	}
}
